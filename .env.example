# Connectors are optional and disabled by default.
# off    = offline: local keyword retrieval, no network calls, no generated answers
# openai = OpenAI embeddings + chat (requires OPENAI_API_KEY)
SECOND_BRAIN_AI=off
# OPENAI_API_KEY=your_openai_api_key

# Optional paths. VAULT_DIR defaults to vault/ if it exists, otherwise sample_vault/.
# VAULT_DIR=/path/to/your/obsidian/vault
# CHROMA_DIR=./chroma_db
